{
  "name": "@alishpawn/shadcn-lexical-editor",
  "version": "0.1.0",
  "description": "A rich text editor component for shadcn/ui built with Lexical",
  "type": "module",
  "exports": {
    ".": "./registry/index.tsx"
  },
  "files": [
    "registry"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "build:registry": "node scripts/build-registry.mjs"
  },
  "keywords": [
    "shadcn",
    "lexical",
    "editor",
    "rich-text",
    "wysiwyg",
    "react"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "@lexical/code": "^0.44.0",
    "@lexical/extension": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/mark": "^0.44.0",
    "@lexical/markdown": "^0.44.0",
    "@lexical/overflow": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/selection": "^0.44.0",
    "@lexical/table": "^0.44.0",
    "@lexical/text": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "lexical": "^0.44.0",
    "lucide-react": "^0.300.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
